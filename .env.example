# Copy to .env and fill in. NEVER commit .env
# (Comments stay on their own lines: docker --env-file does not strip inline comments.)

# Free key from aistudio.google.com (no card)
GEMINI_API_KEY=
# Tested: 27/27 notes correct, p95 1.8 s; free tier 15 RPM / 500 RPD
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional 2nd Gemini model with its own quota (15 RPM / 500 RPD); empty = skip
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Gemini 3 can't disable thinking; "low" or "minimal"
GEMINI_REASONING_EFFORT=low

# Optional backup: free key from console.groq.com (no card); empty = skip Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Per-call LLM timeout in seconds
LLM_TIMEOUT_S=8
PORT=8000
